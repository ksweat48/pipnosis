# Frontend Environment Variables
VITE_MT5_BRIDGE_HOST=localhost
VITE_MT5_BRIDGE_PORT=8765
VITE_DEV_MODE=true

# Backend Environment Variables (for server/.env)
PORT=3001
NODE_ENV=development

# Supabase (Backend)


# MT5 Integration
MT5_BRIDGE_URL=http://localhost:8080
