# =============================================================================
# PIPNOSIS AI TRADING PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file documents all required environment variables for the application.
# Copy this file to .env and fill in your actual values.
#
# SECURITY NOTICE:
# - NEVER commit .env files with real credentials to version control
# - The .env file is in .gitignore for your protection
# - Service role keys and admin tokens must ONLY be in Netlify environment variables
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Get these from Supabase Dashboard > Project Settings > API
# Project: Bolt Native Database (nzisgxdlydihlwsvonfy)
# Region: AWS us-east-1

# Supabase Project URL (used by frontend and backend)
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase Anonymous Key (safe to expose in browser - used by frontend)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (SENSITIVE - for Netlify Functions only)
# IMPORTANT: This key bypasses Row Level Security - handle with extreme care
# Set this in:
# 1. Local .env file for testing Netlify functions locally
# 2. Netlify Dashboard > Site settings > Environment variables for production
# Get from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_ROLE=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# METAAPI CONFIGURATION
# -----------------------------------------------------------------------------
# MetaAPI provides real-time forex market data and trading capabilities
# Get credentials from: https://app.metaapi.cloud/

# IMPORTANT: Understanding VITE_ Prefix
# ======================================
# Variables with VITE_ prefix:
#   - Available during build time and compiled into frontend code
#   - Accessible in browser via import.meta.env.VITE_*
#   - NOT accessible to Netlify functions at runtime
#
# Variables without VITE_ prefix:
#   - Available to Netlify functions at runtime
#   - NOT accessible to frontend code
#   - Required for backend serverless functions

# Frontend Variables (Build-time only)
# -------------------------------------
# These are compiled into your frontend bundle during build

# MetaAPI Account ID (your trading account identifier)
VITE_METAAPI_ACCOUNT_ID=your_metaapi_account_id

# MetaAPI Region (must match where your account is deployed)
# Options: new-york (US), london (EU), singapore (Asia), tokyo (Asia)
VITE_METAAPI_REGION=london

# Backend Variables (Runtime for Netlify Functions)
# --------------------------------------------------
# These are required for Netlify serverless functions to work

# MetaAPI Admin Token (HIGHLY SENSITIVE - Backend Only)
# This is your master token that grants full access to your MetaAPI account
# CRITICAL SECURITY REQUIREMENTS:
# - NEVER expose this in browser/frontend code
# - NEVER commit this to version control
# - Used ONLY by Netlify serverless functions to generate temporary tokens
# - Temporary tokens (1-hour validity) are cached in Supabase for performance
# Set this in:
# 1. Local .env file for development/testing
# 2. Netlify Dashboard > Site settings > Environment variables (REQUIRED for production)
# Get from: MetaAPI Dashboard > API Tokens > Generate Admin Token
METAAPI_ADMIN_TOKEN=your_admin_token_here

# MetaAPI Account ID (Backend copy - same value as VITE_ version)
# REQUIRED for Netlify functions to access MetaAPI
METAAPI_ACCOUNT_ID=your_metaapi_account_id

# MetaAPI Region (Backend copy - same value as VITE_ version)
# REQUIRED for Netlify functions to access MetaAPI
METAAPI_REGION=london

# -----------------------------------------------------------------------------
# ADMIN CONFIGURATION
# -----------------------------------------------------------------------------
# Admin Refresh Key (secret key for administrative operations)
# Used to authorize manual data refresh and batch operations
# Choose a strong, unique secret key
ADMIN_REFRESH_KEY=your_secure_admin_key_here

# -----------------------------------------------------------------------------
# NETLIFY DEPLOYMENT CHECKLIST
# -----------------------------------------------------------------------------
# Ensure ALL of these variables are set in Netlify Dashboard:
#
# Supabase (Required):
# ✓ VITE_SUPABASE_URL
# ✓ VITE_SUPABASE_ANON_KEY
# ✓ SUPABASE_SERVICE_ROLE_KEY (critical for functions)
#
# MetaAPI Frontend (Build-time - Required):
# ✓ VITE_METAAPI_ACCOUNT_ID
# ✓ VITE_METAAPI_REGION
#
# MetaAPI Backend (Runtime - CRITICAL for Netlify Functions):
# ✓ METAAPI_ADMIN_TOKEN (critical for token generation)
# ✓ METAAPI_ACCOUNT_ID (critical - same value as VITE_METAAPI_ACCOUNT_ID)
# ✓ METAAPI_REGION (critical - same value as VITE_METAAPI_REGION)
#
# Admin:
# ✓ ADMIN_REFRESH_KEY
#
# IMPORTANT: Set BOTH the VITE_ and non-VITE_ versions for MetaAPI variables!
# - VITE_ versions are for frontend (compiled into build)
# - Non-prefixed versions are for backend functions (runtime access)
#
# Navigate to: Netlify Dashboard > Site Settings > Environment Variables
# Add each variable with its corresponding value from your .env file
# =============================================================================

# -----------------------------------------------------------------------------
# OPENAI API CONFIGURATION (SECURE PROXY ARCHITECTURE)
# -----------------------------------------------------------------------------
# OpenAI API key for GPT-4 powered market analysis and natural language processing
# Get your API key from: https://platform.openai.com/api-keys
#
# CRITICAL SECURITY UPDATE:
# ========================
# The application now uses a SECURE PROXY architecture:
# - API key is ONLY stored server-side (Netlify Functions)
# - All AI requests are authenticated with Supabase JWT tokens
# - Rate limiting enforced (100 requests/hour, 500/day per user)
# - Complete usage tracking and cost monitoring
# - Zero client-side API key exposure
#
# Used for:
# - Strategic market analysis and trade decisions
# - Natural language goal interpretation
# - Trade validation and risk assessment
# - Session summaries and learning insights
# - Pattern interpretation and discovery
#
# DEPLOYMENT INSTRUCTIONS:
# ========================
# 1. Set OPENAI_API_KEY in Netlify Dashboard ONLY
#    Navigate to: Netlify Dashboard → Site Settings → Environment Variables
#    Variable name: OPENAI_API_KEY
#    Value: sk-proj-... (your OpenAI API key)
#
# 2. NEVER set VITE_OPENAI_API_KEY anywhere (removed for security)
#    This would expose your key to the browser and OpenAI would revoke it
#
# 3. Local development uses the same secure proxy as production
#
# Backend OpenAI Key (Netlify Functions ONLY)
OPENAI_API_KEY=your_openai_api_key_here_netlify_only

# ⚠️ DEPRECATED - DO NOT USE ⚠️
# VITE_OPENAI_API_KEY has been removed for security
# The frontend now calls a secure authenticated proxy instead
# This prevents API key exposure and enables rate limiting

# Features:
# - JWT-authenticated requests only
# - Per-user rate limiting and quota management
# - Complete cost tracking per user
# - Admin dashboard for usage monitoring
# - Prevents abuse and unauthorized usage
#
# Expected cost: $1-5/day with smart usage + rate limiting protection
# =============================================================================

# -----------------------------------------------------------------------------
# FINNHUB API CONFIGURATION (ONE-TIME HISTORICAL DATA IMPORT)
# -----------------------------------------------------------------------------
# Finnhub provides accurate historical forex and commodity market data
# Get your free API key from: https://finnhub.io/register
#
# PURPOSE: One-time 30-day historical data backfill for AI training
# ========
# This key is used ONLY for initial historical data import to provide:
# - 30 days of accurate OHLCV candle data
# - Clean, continuous price history for AI pattern recognition
# - Production-quality data for effective backtesting
#
# USAGE: One-time batch import script (not integrated into regular polling)
# ======
# After the initial backfill is complete, this key can remain for future
# manual historical imports if needed, but it is NOT used for live data.
#
# RATE LIMITS (Free Tier):
# - 60 API calls per minute
# - 30,000 calls per month (sufficient for one-time 30-day backfill)
#
# SUPPORTED ASSETS:
# - EURUSD, GBPUSD, USDJPY (forex pairs via OANDA provider)
# - XAUUSD (gold via OANDA provider)
# - US30 (Dow Jones index)
#
# DEPLOYMENT:
# ===========
# 1. Sign up at https://finnhub.io/register
# 2. Get your API key from dashboard
# 3. Add to local .env file for testing
# 4. Add to Netlify environment variables for production imports
#
# Finnhub API Key (for both historical import AND sentiment analysis)
# Free tier: 60 calls/min, 30k/month
# Used for: Historical backfill + live market sentiment news
FINNHUB_API_KEY=your_finnhub_api_key_here
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# -----------------------------------------------------------------------------
# FINANCIAL MODELING PREP (FMP) API CONFIGURATION
# -----------------------------------------------------------------------------
# FMP provides financial news and market data for sentiment analysis
# Get your free API key from: https://site.financialmodelingprep.com/developer/docs
#
# PURPOSE: Market sentiment analysis through financial news
# ========
# This key is used for real-time financial news sentiment analysis:
# - Professional financial market headlines
# - Press releases and corporate announcements
# - Market-moving news events
#
# RATE LIMITS (Free Tier):
# - 250 API calls per day
# - 500MB bandwidth per 30 days
# - Resets daily at 3 PM EST
#
# USAGE: Real-time sentiment analysis (10-minute cache = ~144 calls/day)
# ======
# With 10-minute caching, you'll use approximately 144 calls per day,
# well within the free tier limit of 250 calls/day.
#
# DEPLOYMENT:
# ===========
# 1. Sign up at https://site.financialmodelingprep.com/developer/docs
# 2. Get your API key from dashboard
# 3. Add to local .env file: VITE_FMP_API_KEY=your_key
# 4. Add to Netlify environment variables: VITE_FMP_API_KEY=your_key
#
# FMP API Key (for browser-based sentiment analysis)
VITE_FMP_API_KEY=your_fmp_api_key_here

# -----------------------------------------------------------------------------
# WEB PUSH NOTIFICATION CONFIGURATION (VAPID KEYS)
# -----------------------------------------------------------------------------
# VAPID (Voluntary Application Server Identification) keys enable push notifications
# Generate keys with: node scripts/generate-vapid-keys.js
#
# PURPOSE: Send push notifications to users even when app is closed
# ========
# - Trade signal alerts (high-confidence setups)
# - Trade entry confirmations (position opened)
# - Trade exit notifications (TP/SL hit, manual close)
# - Mid-trade alerts (critical market conditions)
# - Goal achievement celebrations
# - Important system notifications
#
# FEATURES:
# ==========
# - Multi-device support (phone, tablet, desktop unlimited)
# - Works even when browser/app is closed
# - Smart notification grouping (collapse similar alerts)
# - Priority-based delivery (urgent vs standard)
# - Quiet hours and DND support
# - Rich notifications with actions
#
# SECURITY:
# =========
# - Public key is safe to expose in browser (used for subscription)
# - Private key MUST be kept secure server-side (used for sending)
# - Keys uniquely identify your application server
# - Standard Web Push protocol with encryption
#
# DEPLOYMENT:
# ===========
# 1. Generate keys: node scripts/generate-vapid-keys.js
# 2. Add VITE_VAPID_PUBLIC_KEY to .env and Netlify
# 3. Add VAPID_PRIVATE_KEY and VAPID_PUBLIC_KEY to Supabase Edge Function secrets
# 4. NEVER commit private key to version control
#
# Frontend Public Key (safe to expose - used for push subscription)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Backend Keys (Netlify Functions and Supabase Edge Functions ONLY)
# CRITICAL: Private key must remain server-side
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here

# =============================================================================
