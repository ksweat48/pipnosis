# =============================================================================
# PIPNOSIS AI TRADING PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file documents all required environment variables for the application.
# Copy this file to .env and fill in your actual values.
#
# SECURITY NOTICE:
# - NEVER commit .env files with real credentials to version control
# - The .env file is in .gitignore for your protection
# - Service role keys and admin tokens must ONLY be in Netlify environment variables
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Get these from Supabase Dashboard > Project Settings > API
# Project: Bolt Native Database (nzisgxdlydihlwsvonfy)
# Region: AWS us-east-1

# Supabase Project URL (used by frontend and backend)
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase Anonymous Key (safe to expose in browser - used by frontend)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (SENSITIVE - for Netlify Functions only)
# IMPORTANT: This key bypasses Row Level Security - handle with extreme care
# Set this in:
# 1. Local .env file for testing Netlify functions locally
# 2. Netlify Dashboard > Site settings > Environment variables for production
# Get from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_ROLE=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# METAAPI CONFIGURATION
# -----------------------------------------------------------------------------
# MetaAPI provides real-time forex market data and trading capabilities
# Get credentials from: https://app.metaapi.cloud/

# IMPORTANT: Understanding VITE_ Prefix
# ======================================
# Variables with VITE_ prefix:
#   - Available during build time and compiled into frontend code
#   - Accessible in browser via import.meta.env.VITE_*
#   - NOT accessible to Netlify functions at runtime
#
# Variables without VITE_ prefix:
#   - Available to Netlify functions at runtime
#   - NOT accessible to frontend code
#   - Required for backend serverless functions

# Frontend Variables (Build-time only)
# -------------------------------------
# These are compiled into your frontend bundle during build

# MetaAPI Account ID (your trading account identifier)
VITE_METAAPI_ACCOUNT_ID=your_metaapi_account_id

# MetaAPI Region (must match where your account is deployed)
# Options: new-york (US), london (EU), singapore (Asia), cloud-g2
VITE_METAAPI_REGION=new-york

# Backend Variables (Runtime for Netlify Functions)
# --------------------------------------------------
# These are required for Netlify serverless functions to work

# MetaAPI Admin Token (HIGHLY SENSITIVE - Backend Only)
# This is your master token that grants full access to your MetaAPI account
# CRITICAL SECURITY REQUIREMENTS:
# - NEVER expose this in browser/frontend code
# - NEVER commit this to version control
# - Used ONLY by Netlify serverless functions to generate temporary tokens
# - Temporary tokens (1-hour validity) are cached in Supabase for performance
# Set this in:
# 1. Local .env file for development/testing
# 2. Netlify Dashboard > Site settings > Environment variables (REQUIRED for production)
# Get from: MetaAPI Dashboard > API Tokens > Generate Admin Token
METAAPI_ADMIN_TOKEN=your_admin_token_here

# MetaAPI Account ID (Backend copy - same value as VITE_ version)
# REQUIRED for Netlify functions to access MetaAPI
METAAPI_ACCOUNT_ID=your_metaapi_account_id

# MetaAPI Region (Backend copy - same value as VITE_ version)
# REQUIRED for Netlify functions to access MetaAPI
METAAPI_REGION=new-york

# -----------------------------------------------------------------------------
# ADMIN CONFIGURATION
# -----------------------------------------------------------------------------
# Admin Refresh Key (secret key for administrative operations)
# Used to authorize manual data refresh and batch operations
# Choose a strong, unique secret key
ADMIN_REFRESH_KEY=your_secure_admin_key_here

# -----------------------------------------------------------------------------
# NETLIFY DEPLOYMENT CHECKLIST
# -----------------------------------------------------------------------------
# Ensure ALL of these variables are set in Netlify Dashboard:
#
# Supabase (Required):
# ✓ VITE_SUPABASE_URL
# ✓ VITE_SUPABASE_ANON_KEY
# ✓ SUPABASE_SERVICE_ROLE_KEY (critical for functions)
#
# MetaAPI Frontend (Build-time - Required):
# ✓ VITE_METAAPI_ACCOUNT_ID
# ✓ VITE_METAAPI_REGION
#
# MetaAPI Backend (Runtime - CRITICAL for Netlify Functions):
# ✓ METAAPI_ADMIN_TOKEN (critical for token generation)
# ✓ METAAPI_ACCOUNT_ID (critical - same value as VITE_METAAPI_ACCOUNT_ID)
# ✓ METAAPI_REGION (critical - same value as VITE_METAAPI_REGION)
#
# Admin:
# ✓ ADMIN_REFRESH_KEY
#
# IMPORTANT: Set BOTH the VITE_ and non-VITE_ versions for MetaAPI variables!
# - VITE_ versions are for frontend (compiled into build)
# - Non-prefixed versions are for backend functions (runtime access)
#
# Navigate to: Netlify Dashboard > Site Settings > Environment Variables
# Add each variable with its corresponding value from your .env file
# =============================================================================
