# Frontend Environment Variables
VITE_DEV_MODE=true

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-Side Supabase (for Netlify Functions)
# Get this from Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# MetaApi Configuration
VITE_METAAPI_TOKEN=your_metaapi_token
VITE_METAAPI_ACCOUNT_ID=your_metaapi_account_id
# MetaApi Region: new-york (US), london (EU), or singapore (Asia)
# Must match the region where your MetaAPI account is deployed
VITE_METAAPI_REGION=new-york

# Server-Side MetaApi (for Supabase Edge Functions)
# This is used by the metaapi-token edge function to generate secure temporary tokens
# IMPORTANT: This MUST be the same value as VITE_METAAPI_TOKEN
# IMPORTANT: This MUST be configured in BOTH:
#   1. Your local .env file (for development)
#   2. Supabase Dashboard > Project Settings > Edge Functions > Secrets (for production)
# The edge function uses this to create scoped, short-lived tokens for enhanced security
METAAPI_TOKEN=your_metaapi_token

# OPTIONAL: Configure Deno TLS Certificate Store (for Supabase Edge Functions)
# Set this in Supabase Dashboard > Project Settings > Edge Functions > Secrets
# If you encounter SSL certificate errors, set this to: mozilla,system
# DENO_TLS_CA_STORE=mozilla,system

# Admin Configuration
# Secret key for triggering manual and batch refresh operations
ADMIN_REFRESH_KEY=your_secure_admin_key_here
