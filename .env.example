# Frontend Environment Variables
VITE_DEV_MODE=true

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-Side Supabase (for Netlify Functions)
# Get this from Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# MetaApi Configuration (Frontend - Safe to expose)
VITE_METAAPI_ACCOUNT_ID=your_metaapi_account_id
# MetaApi Region: new-york (US), london (EU), or singapore (Asia)
# Must match the region where your MetaAPI account is deployed
VITE_METAAPI_REGION=new-york

# MetaApi Admin Token (Backend Only - NEVER commit or expose in browser)
# Set this in Netlify Dashboard > Site settings > Environment variables
# DO NOT set this in .env files that are committed to git
METAAPI_ADMIN_TOKEN=your_admin_token_here

# Admin Configuration
# Secret key for triggering manual and batch refresh operations
ADMIN_REFRESH_KEY=your_secure_admin_key_here
